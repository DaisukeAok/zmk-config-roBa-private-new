#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 160

&mt {
    flavor = "tap-preferred";
    quick-tap-ms = <175>;
    require-prior-idle-ms = <135>;
    tapping-term-ms = <200>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <8>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <12 11>;
            require-prior-idle-ms = <200>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
            require-prior-idle-ms = <200>;
        };

        single_quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <19 20>;
            require-prior-idle-ms = <200>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <8 9>;
            require-prior-idle-ms = <200>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
            require-prior-idle-ms = <200>;
        };

        sign_layer {
            bindings = <&mo 2>;
            key-positions = <37 41>;
            require-prior-idle-ms = <200>;
        };

        space {
            bindings = <&kp SPACE>;
            key-positions = <39 38>;
            require-prior-idle-ms = <200>;
        };

        ctrl_space {
            bindings = <&kp LC(SPACE)>;
            key-positions = <10 38>;
            require-prior-idle-ms = <200>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <41 40>;
        };

        backspace_quick {
            bindings = <&kp BACKSPACE>;
            key-positions = <17 12>;
        };

        capslock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <10 21>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        encoder_brightness: encoder_brightness {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_BRIGHTNESS";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_BRIGHTNESS_DEC>, <&kp C_BRIGHTNESS_INC>;

            tap-ms = <20>;
        };

        encoder_volume: encoder_volume {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_VOLUME";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_VOL_DN>, <&kp C_VOL_UP>;

            tap-ms = <20>;
        };

        lt_space: lt_space {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_SPACE";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };

        td_j_esc: td_j_esc {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_J_ESC";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp J>, <&kp ESCAPE>;
        };

        mt_st: mt_st {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_ST";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <160>;
            bindings = <&sk>, <&kp>;

            require-prior-idle-ms = <200>;
        };

        mt_shift: mt_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_SHIFT";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <135>;
            quick-tap-ms = <175>;
        };

        mt_cmd: mt_cmd {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_CMD";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <160>;
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <135>;
            quick-tap-ms = <175>;
        };

        gqt: global-quick-tap {
            compatible = "zmk,behavior-hold-tap";
            label = "GLOBAL_QUICK_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <175>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <135>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&mt ESCAPE Q            &kp W            &kp E         &kp R                  &kp T                                    &kp Y             &kp U      &kp I                 &kp O             &kp P
&gqt LSHIFT A           &gqt LEFT_ALT S  &gqt LCTRL D  &gqt RIGHT_GUI F       &kp G      &mkp MCLK          &none      &gqt BACKSPACE H  &td_j_esc  &gqt RIGHT_CONTROL K  &gqt RIGHT_ALT L  &gqt RSHIFT SEMICOLON
&mt_shift LEFT_SHIFT Z  &gqt LEFT_ALT X  &kp C         &kp V                  &kp B      &mkp LCLK          &none      &kp N             &kp M      &kp COMMA             &kp DOT           &kp SLASH
&sl 6                   &none            &mo 3         &mt_cmd LEFT_GUI LGUI  &kp SPACE  &kp BACKSPACE      &kp ENTER  &lt 1 RIGHT_GUI                                                      &kp BACKSLASH
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        NUM {
            bindings = <
&kp NUMBER_1          &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                                                  &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
&mt LEFT_SHIFT GRAVE  &trans        &trans        &trans        &trans        &trans                    &trans                &kp HASH      &kp PLUS      &kp MINUS     &kp EQUAL     &mt RIGHT_SHIFT SINGLE_QUOTE
&trans                &trans        &trans        &trans        &trans        &trans                    &trans                &trans        &trans        &trans        &trans        &trans
&trans                &mo 5         &trans        &mo 2         &trans        &kp C_BRIGHTNESS_DEC      &kp C_BRIGHTNESS_INC  &trans                                                  &trans
            >;

            sensor-bindings = <&encoder_brightness>;
        };

        SIGN {
            bindings = <
&kp EXCLAMATION    &kp AT_SIGN  &kp POUND  &kp DOLLAR  &kp PERCENT                                  &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&mt GRAVE AT_SIGN  &trans       &trans     &trans      &trans       &trans            &trans        &trans     &kp PLUS       &kp MINUS     &kp EQUAL             &kp MINUS
&trans             &trans       &trans     &trans      &trans       &trans            &trans        &trans     &trans         &trans        &trans                &trans
&trans             &trans       &trans     &trans      &trans       &kp C_VOL_DN      &kp C_VOL_UP  &trans                                                        &trans
            >;

            sensor-bindings = <&encoder_volume>;
        };

        ARROW {
            bindings = <
&kp ESCAPE  &trans  &trans          &kp UP_ARROW    &trans                                                   &trans     &trans          &kp UP_ARROW    &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&trans      &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans                 &trans           &trans     &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW   &kp SINGLE_QUOTE
&trans      &trans  &trans          &trans          &trans           &trans                 &trans           &trans     &mkp RCLK       &trans          &trans            &trans
&trans      &trans  &trans          &trans          &trans           &kp C_VOLUME_DOWN      &kp C_VOLUME_UP  &mkp LCLK                                                    &trans
            >;

            sensor-bindings = <&encoder_volume>;
        };

        MOUSE {
            bindings = <
&kp ESCAPE  &trans  &trans  &trans  &trans                      &trans  &mkp RCLK  &to 8           &trans  &trans
&trans      &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp LCLK  &msc SCRL_DOWN  &trans  &trans
&trans      &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans     &trans          &trans  &trans
&trans      &trans  &trans  &trans  &trans  &trans      &trans  &trans                                     &trans
            >;
        };

        BLT {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                  &bt BT_CLR_ALL
            >;
        };

        Function {
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &kp F5                       &kp F6   &kp F7   &kp F8   &kp F9   &kp F10
&kp F11  &kp F12  &kp F13  &kp F14  &kp F15  &trans      &trans  &kp F16  &kp F17  &kp F18  &kp F19  &kp F20
&trans   &trans   &trans   &trans   &trans   &trans      &trans  &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans      &trans  &trans                              &trans
            >;
        };

        Windows {
            bindings = <
&kp Q                   &kp W           &kp E        &kp R               &kp T                                        &kp Y               &kp U                &lt 0 I              &kp O            &kp P
&mt LEFT_SHIFT A        &mt LEFT_ALT S  &mt LCTRL D  &mt LEFT_CONTROL F  &kp G              &mkp MCLK      &none      &kp H               &mt RIGHT_CONTROL J  &mt RIGHT_CONTROL K  &mt RIGHT_ALT L  &mt RIGHT_SHIFT SEMICOLON
&mt_shift LEFT_SHIFT Z  &kp X           &kp C        &kp V               &kp B              &mkp LCLK      &to 0      &kp N               &kp M                &kp COMMA            &kp DOT          &kp SLASH
&sl 6                   &kp LEFT_WIN    &mo 2        &lt 3 LEFT_CONTROL  &lt_space 2 SPACE  &mo 2          &kp ENTER  &lt 1 LEFT_CONTROL                                                             &kp BACKSLASH
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        Scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &to 0   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
